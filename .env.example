# Runtime
SURVEY_AGENT_LOG_LEVEL=info
SURVEY_AGENT_DATA_DIR=./data
SURVEY_AGENT_ALLOWED_DOMAINS=localhost,127.0.0.1
SURVEY_AGENT_BROWSER_MODE=managed_chromium
# Required only when SURVEY_AGENT_BROWSER_MODE=attached_chrome. Must be loopback-only.
SURVEY_AGENT_CDP_ENDPOINT=

# LLM provider. "mock" is safe for local development and tests.
SURVEY_AGENT_LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
