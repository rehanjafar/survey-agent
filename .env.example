# Runtime
SURVEY_AGENT_LOG_LEVEL=info
SURVEY_AGENT_DATA_DIR=./data
SURVEY_AGENT_ALLOWED_DOMAINS=localhost,127.0.0.1
SURVEY_AGENT_BROWSER_MODE=managed_chromium
# Required only when SURVEY_AGENT_BROWSER_MODE=attached_chrome. Must be loopback-only.
SURVEY_AGENT_CDP_ENDPOINT=

# LLM provider. "mock" is safe for local development and tests.
SURVEY_AGENT_LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Separate opt-in navigation scopes. Exact host or *.host (apex + subdomains).
# Keep auth-only hosts out of SURVEY_AGENT_SURVEY_DOMAINS.
SURVEY_AGENT_AUTH_DOMAINS=
SURVEY_AGENT_SURVEY_DOMAINS=
# Dedicated persistent Chrome profile for manual login. Never use your daily Chrome profile.
SURVEY_AGENT_PROFILE_DIR=./data/chrome-profile
# Set SURVEY_AGENT_LLM_PROVIDER=manual_chatgpt for the interactive Eureka command.
# This mode never calls paid APIs; paste the prompt/reply through a normal ChatGPT chat.

# Fully automated supported survey pages, using eligible ChatGPT plan usage.
# Run chatgpt-login once, then chatgpt-models and choose an available model.
# SURVEY_AGENT_LLM_PROVIDER=chatgpt_plan
SURVEY_AGENT_CHATGPT_ACCOUNT=default
SURVEY_AGENT_CHATGPT_MODEL=
SURVEY_AGENT_MAX_SURVEYS=10
SURVEY_AGENT_MAX_STEPS=100
SURVEY_AGENT_REVIEW_TIMEOUT_MINUTES=60
# Run notify-setup to generate a private random topic, then subscribe in the ntfy phone app.
# Or supply your existing ntfy topic; token is optional for access-controlled topics.
SURVEY_AGENT_NTFY_TOPIC_URL=
SURVEY_AGENT_NTFY_TOKEN=
